APP_NAME=SmartStudyPro
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
APP_TIMEZONE=Africa/Kampala
APP_STORAGE_PATH=/home/account/private/smartstudypro-storage
DB_PATH=/home/account/private/smartstudypro-storage/smartstudypro.sqlite
APP_MAIL_FROM=no-reply@smartstudypro.com
GOOGLE_CLIENT_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_INPUT_TOKEN_BUDGET=6000
GROQ_OUTPUT_TOKEN_BUDGET=1200
GROQ_DAILY_REQUEST_LIMIT=20
GROQ_DAILY_TOKEN_LIMIT=30000
GROQ_MEETING_REQUEST_LIMIT=8
GROQ_MEETING_TOKEN_LIMIT=12000
GROQ_MEETINGS_ENABLED=true
# Store GROQ_API_KEY only in the server environment or private $APP_STORAGE_PATH/.env
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_UGX_PER_USD=3700
PAYPAL_WEBHOOK_ID=
DPO_COMPANY_TOKEN=
DPO_ENDPOINT=https://secure.3gdirectpay.com/API/v6/
DPO_CHECKOUT_URL=https://secure.3gdirectpay.com/payv2.php
DPO_SERVICE_TYPE=5525
DEMO_PAYMENTS_ALLOWED=false
