Options -Indexes -MultiViews
RewriteEngine On

RewriteRule ^favicon\.ico$ favicon.php [L]

RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s/+index\.php(?:[?\s]) [NC]
RewriteRule ^index\.php$ / [R=301,L]
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s/+about\.php(?:[?\s]) [NC]
RewriteRule ^about\.php$ /about [R=301,L]
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s/+admin\.php(?:[?\s]) [NC]
RewriteRule ^admin\.php$ /admin [R=301,L]
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s/+booking\.php(?:[?\s]) [NC]
RewriteRule ^booking\.php$ /booking [R=301,L]
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s/+cart\.php(?:[?\s]) [NC]
RewriteRule ^cart\.php$ /cart [R=301,L]
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s/+checkout\.php(?:[?\s]) [NC]
RewriteRule ^checkout\.php$ /checkout [R=301,L]
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s/+contact\.php(?:[?\s]) [NC]
RewriteRule ^contact\.php$ /contact [R=301,L]
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s/+courses\.php(?:[?\s]) [NC]
RewriteRule ^courses\.php$ /courses [R=301,L]
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s/+products\.php(?:[?\s]) [NC]
RewriteRule ^products\.php$ /products [R=301,L]
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s/+login\.php(?:[?\s]) [NC]
RewriteRule ^login\.php$ /login [R=301,L]
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s/+logout\.php(?:[?\s]) [NC]
RewriteRule ^logout\.php$ /logout [R=301,L]
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s/+profile\.php(?:[?\s]) [NC]
RewriteRule ^profile\.php$ /profile [R=301,L]
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s/+register\.php(?:[?\s]) [NC]
RewriteRule ^register\.php$ /register [R=301,L]
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s/+reset\.php(?:[?\s]) [NC]
RewriteRule ^reset\.php$ /reset [R=301,L]
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s/+learning\.php(?:[?\s]) [NC]
RewriteRule ^learning\.php$ /learn [R=301,L]
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s/+terms\.php(?:[?\s]) [NC]
RewriteRule ^terms\.php$ /terms [R=301,L]
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s/+privacy\.php(?:[?\s]) [NC]
RewriteRule ^privacy\.php$ /privacy [R=301,L]
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s/+cookies\.php(?:[?\s]) [NC]
RewriteRule ^cookies\.php$ /cookies [R=301,L]
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s/+accessibility\.php(?:[?\s]) [NC]
RewriteRule ^accessibility\.php$ /accessibility [R=301,L]
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s/+eula\.php(?:[?\s]) [NC]
RewriteRule ^eula\.php$ /eula [R=301,L]
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s/+refunds\.php(?:[?\s]) [NC]
RewriteRule ^refunds\.php$ /refunds [R=301,L]

RewriteRule ^(?:app|bootstrap|config|database|scripts|tests|storage|cms|docs)(?:/|$) - [F,L,NC]
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L,NC]

<FilesMatch "^(\.env|composer\.(json|lock)|phpunit\.xml|\.gitignore)$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(sqlite|sqlite3|db|log|key|sql|bak|backup|old|orig|swp|zip|tar|gz|dump|sqlite-wal|sqlite-shm|db-wal|db-shm)$">
    Require all denied
</FilesMatch>

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^courses/([a-z0-9][a-z0-9-]*)/?$ course-details.php?slug=$1 [L,QSA,NC]
RewriteRule ^courses/?$ courses.php [L,QSA]
RewriteRule ^learn/([a-z0-9][a-z0-9-]*)/([0-9]+)/?$ study.php?course_slug=$1&lesson_id=$2 [L,QSA,NC]
RewriteRule ^learn/([a-z0-9][a-z0-9-]*)/?$ study.php?course_slug=$1 [L,QSA,NC]
RewriteRule ^learning/?$ /learn [R=301,L]
RewriteRule ^learn/?$ learning.php [L,QSA]
RewriteRule ^products/([a-z0-9][a-z0-9-]*)/?$ product-details.php?slug=$1 [L,QSA,NC]

RewriteRule ^about/?$ about.php [L,QSA]
RewriteRule ^admin/?$ admin.php [L,QSA]
RewriteRule ^booking/?$ booking.php [L,QSA]
RewriteRule ^cart/add/?$ cart-add.php [L,QSA]
RewriteRule ^cart/?$ cart.php [L,QSA]
RewriteRule ^checkout/?$ checkout.php [L,QSA]
RewriteRule ^contact/?$ contact.php [L,QSA]
RewriteRule ^course-details/?$ /courses [R=301,L]
RewriteRule ^login/?$ login.php [L,QSA]
RewriteRule ^logout/?$ logout.php [L,QSA]
RewriteRule ^product-details/?$ /products [R=301,L]
RewriteRule ^products/?$ products.php [L,QSA]
RewriteRule ^privacy/?$ privacy.php [L,QSA]
RewriteRule ^terms/?$ terms.php [L,QSA]
RewriteRule ^cookies/?$ cookies.php [L,QSA]
RewriteRule ^accessibility/?$ accessibility.php [L,QSA]
RewriteRule ^eula/?$ eula.php [L,QSA]
RewriteRule ^profile/?$ profile.php [L,QSA]
RewriteRule ^register/?$ register.php [L,QSA]
RewriteRule ^reset/?$ reset.php [L,QSA]
RewriteRule ^stream/?$ stream.php [L,QSA]
RewriteRule ^study/?$ /learn [R=301,L]
RewriteRule ^refunds/?$ refunds.php [L,QSA]
